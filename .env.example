# TestAgent 环境变量配置文件
# 复制此文件为 .env 并填入实际的配置值

# 基本配置
DEBUG=false
TESTING=false
ENVIRONMENT=development

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/testagent.log

# LLM配置
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-3.5-turbo

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_openai_organization_id_here

# Anthropic配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI配置
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2023-12-01-preview

# 向量数据库配置
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/vectordb

# API服务器配置
API_HOST=0.0.0.0
API_PORT=8000

# MCP配置
MCP_SERVERS_CONFIG=./config/mcp_servers.json

# 缓存配置
REDIS_URL=redis://localhost:6379/0

# GitHub配置（用于MCP GitHub服务器）
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here

# Brave搜索配置（用于MCP Web搜索服务器）
BRAVE_API_KEY=your_brave_api_key_here

# 数据库配置
DATABASE_URL=sqlite:///./data/testagent.db

# 其他第三方服务配置
# 根据需要添加其他API密钥和配置